---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { learningEntries, projectEntries } from '../lib/content';
import { href, site } from '../lib/site';
const articles = (await learningEntries()).slice(0, 3);
const allProjects = await projectEntries();
const projects = allProjects.filter(p => p.data.featured);
const shownProjects = (projects.length ? projects : allProjects).slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">
      <span class="status-dot"></span>
      Portfolio & Learning Notes
    </p>

    <h1>
      石井晴大
      <span class="hero-role">
        Cloud / Infrastructure Engineering
      </span>
    </h1>

    <p class="intro">
      クラウド・インフラ技術を中心に、
      実際に構築しながら学んだことと制作物を記録しています。
    </p>

    <div class="hero-actions">
      <a class="button primary" href={href('projects/')}>
        Projects <span aria-hidden="true">↗</span>
      </a>

      <a class="button" href={href('learning/')}>
        Learning <span aria-hidden="true">→</span>
      </a>

      {
        site.github ? (
          <a class="text-link" href={site.github}>
            GitHub ↗
          </a>
        ) : (
          <span class="placeholder-link">
              GitHub: https://github.com/runharu0662
          </span>
        )
      }
    </div>

    <a class="about-link" href={href('about/')}>
      About me <span aria-hidden="true">→</span>
    </a>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Build</p>
        <h2>Projects</h2>
      </div>

      <a href={href('projects/')}>
        すべての制作物 →
      </a>
    </div>

    <div class="card-grid">
      {
        shownProjects.map((entry) => (
          <ProjectCard entry={entry} />
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / Understand</p>
        <h2>Learning</h2>
      </div>

      <a href={href('learning/')}>
        学習記録へ →
      </a>
    </div>

    <div class="card-grid">
      {
        articles.map((entry) => (
          <ArticleCard entry={entry} />
        ))
      }
    </div>
  </section>
</BaseLayout>
