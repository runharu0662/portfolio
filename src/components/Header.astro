---
import { href, site } from '../lib/site';
const links = [['Home', ''], ['About', 'about/'], ['Projects', 'projects/'], ['Learning', 'learning/']];
---
<header class="site-header"><div class="container header-inner">
  <a class="brand" href={href()}><span class="brand-mark" aria-hidden="true">&gt;_</span>{site.name}</a>
  <nav aria-label="メインナビゲーション">{links.map(([name, path]) => <a href={href(path)} aria-current={(path ? Astro.url.pathname.startsWith(href(path)) : Astro.url.pathname === href()) ? 'page' : undefined}>{name}</a>)}</nav>
  <button id="theme-toggle" class="theme-toggle" type="button" aria-label="ダークテーマに切り替える" aria-pressed="false">Theme <span aria-hidden="true">◐</span></button>
</div></header>
<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const sync = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    button?.setAttribute('aria-pressed', String(dark));
    button?.setAttribute('aria-label', `${dark ? 'ライト' : 'ダーク'}テーマに切り替える`);
  };
  button?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('theme', theme); } catch {}
    sync();
  });
  media.addEventListener('change', event => {
    let saved; try { saved = localStorage.getItem('theme'); } catch {}
    if (!saved) document.documentElement.dataset.theme = event.matches ? 'dark' : 'light';
    sync();
  });
  sync();
</script>
